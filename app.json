{
  "expo": {
    "name": "ECFC Présences",
    "slug": "ecfc-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ecfc",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#D7141A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.etoilecarougefc.attendance"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D7141A"
      },
      "package": "ch.etoilecarougefc.attendance"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à vos photos pour ajouter la photo d'un joueur."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/ECFC-FE12"
    }
  }
}
